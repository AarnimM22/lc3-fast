/* The DK has no DAC fitted.  Route a real 48 kHz, 24-bit I2S stream to
 * header pins so the EasyDMA engine and its transfer interrupts run during
 * the decode test. */

/ {
    aliases {
        i2s-tx = &i2s0;
    };
};

&pinctrl {
    bench_i2s_default: bench_i2s_default {
        group1 {
            psels = <NRF_PSEL(I2S_MCK, 0, 12)>;
            nordic,drive-mode = <NRF_DRIVE_H0H1>;
        };
        group2 {
            psels = <NRF_PSEL(I2S_SCK_M, 1, 15)>,
                    <NRF_PSEL(I2S_LRCK_M, 1, 12)>,
                    <NRF_PSEL(I2S_SDOUT, 1, 13)>,
                    <NRF_PSEL(I2S_SDIN, 1, 14)>;
        };
    };
};

&i2s0 {
    status = "okay";
    pinctrl-0 = <&bench_i2s_default>;
    pinctrl-names = "default";
    clock-source = "ACLK";
};

&clock {
    hfclkaudio-frequency = <12288000>;
};

&i2c1 {
    status = "okay";
};
